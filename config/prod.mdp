; Stage 4c - production MD, 50 ns, no restraints.
;
; TRAJECTORY OUTPUT POLICY - set before running anything, per the build
; instructions, which name uncontrolled trajectory writing as the single most
; likely way to fill the filesystem.
;
;   reduced trajectory : receptor + DAMGO + proximal lipids, every 100 ps
;   full system        : every 5 ns, sparsely
;
; At 50 ns that is 500 reduced frames and 10 full frames. The reduced group is
; built by scripts/04_make_index.py and selected here through compressed-x-grps.

integrator              = md
dt                      = 0.002
nsteps                  = 25000000        ; 50 ns
tinit                   = 0

continuation            = yes
constraints             = h-bonds
constraint-algorithm    = lincs
lincs-order             = 4
lincs-iter              = 1

cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1.0
fourierspacing          = 0.12
vdwtype                 = cutoff
vdw-modifier            = potential-shift-verlet
rvdw                    = 1.0
DispCorr                = EnerPres

tcoupl                  = v-rescale
tc-grps                 = Protein_DAM MEMB SOLV
tau-t                   = 1.0 1.0 1.0
ref-t                   = 310 310 310

; SEMI-ISOTROPIC pressure coupling is mandatory for a bilayer: xy and z must
; scale independently or the membrane is squeezed to the wrong area per lipid.
; This is also what lets a slightly loose pack relax to the correct density,
; which is why under-packing was the recoverable error and over-packing was not.
pcoupl                  = C-rescale
pcoupltype              = semiisotropic
tau-p                   = 5.0
ref-p                   = 1.0 1.0
compressibility         = 4.5e-5 4.5e-5

gen-vel                 = no

nstlog                  = 25000
nstenergy               = 25000

; reduced trajectory, 100 ps
nstxout-compressed      = 50000
compressed-x-grps       = Reduced

; full system, 5 ns
nstxout                 = 2500000
